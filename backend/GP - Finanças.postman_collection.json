    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Cadastrar Usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 201 (Criado)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Retorna dados do usuário sem senha', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.not.have.property('password');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Elisangela Prins\",\n  \"email\": \"elisangela@exemplo.com\",\n  \"password\": \"SenhaSegura@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
